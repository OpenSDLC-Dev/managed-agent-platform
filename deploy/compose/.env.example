# Copy to .env and edit. docker compose reads it automatically. Never commit .env.

# Bootstrap management API key the real `ant` CLI / SDKs send as x-api-key. Required.
CONTROLPLANE_API_KEY=local-dev-key

# Postgres password for the bundled database. It is embedded in DATABASE_URL, so
# keep it URL-safe (no @ : / ? # % or spaces); any such value works, it is used
# only inside the stack.
POSTGRES_PASSWORD=map

# Host port the controlplane is published on (container always listens on 8080).
CONTROLPLANE_PORT=8080

# Interface the controlplane port binds to. Loopback by default so the API — which
# accepts the placeholder key above — is not reachable from the network. Set to
# 0.0.0.0 only with a real CONTROLPLANE_API_KEY.
# CONTROLPLANE_BIND=127.0.0.1

# Base image the executor uses for per-session sandbox containers.
EXECUTOR_IMAGE=debian:stable-slim

# Brain model routing. Defaults to the committed model-providers.example.json (so
# the stack starts out of the box, idling). To use your endpoint:
#   cp model-providers.example.json model-providers.json   # then edit it
#   MODEL_PROVIDERS_FILE=model-providers.json              # uncomment below
# MODEL_PROVIDERS_FILE=model-providers.json

# Traces: uncomment both and run `docker compose --profile observability up` to
# send spans to the bundled Jaeger (UI at http://localhost:16686). INSECURE=true
# is correct for the local plaintext Jaeger; leave it false for a TLS collector.
# OTEL_EXPORTER_OTLP_ENDPOINT=jaeger:4317
# OTEL_EXPORTER_OTLP_INSECURE=true

# Single sign-on (docs/plan/31_console-sso-rbac.md). Off unless IDENTITY_MODE is
# set: with it unset the control plane reads none of the rest and management auth
# stays x-api-key only. Uncomment ALL SEVEN — the six IDENTITY_* below and
# SSL_CERT_FILE with them — and run `docker compose --profile iam up` to start the
# bundled Casdoor. Six of seven is a control plane that exits at boot with
# `x509: certificate signed by unknown authority` and restarts forever.
#
# IDENTITY_OIDC_ISSUER must equal the IdP's `origin` byte for byte, because that
# value becomes the `iss` claim and the verifier compares it exactly. The JWKS URL
# is a different host on purpose and is NOT optional here: the control plane
# requires https for a key set, so it fetches through the proxy's TLS listener
# while the browser keeps plain HTTP on the issuer above.
#
# Setting IDENTITY_CLAIM_ROLES to `groups` is load-bearing (and this line is
# prose, not a setting to uncomment). Casdoor's `roles` claim carries
# role OBJECTS, and the platform reads only string values out of a claim, so
# mapping `roles` would silently give every human no role at all — and a role of
# none is denied everywhere. `groups` carries strings, spelled `organization/name`,
# which is why the map keys below are prefixed with the seeded org.
#
# How you SPELL a claim name decides how it is read, and the reading is fixed
# here rather than inferred from the token: a name with no dot (`groups`, above)
# is one top-level claim; a URI-shaped name is also one top-level claim, dots
# and all (`https://corp.example/roles` — the Auth0/Okta/Entra convention); any
# other dotted name is a PATH walked segment by segment
# (`resource_access.console.roles`, the Keycloak shape). Deciding from your
# configured name is what stops a user who can set a flat claim literally named
# `resource_access.console.roles` from outranking the real nested one.
#
# The audience is the application's CLIENT ID, because that is what Casdoor puts
# in `aud`. Both values below match deploy/compose/casdoor-init-data.json; change
# them together or the token stops verifying.
#
# The seed creates four accounts, all with development passwords in a committed
# file — map-admin / map-dev / map-viewer (one per role, password `<name>-dev`)
# and Casdoor's own global administrator built-in/admin, whose password the seed
# resets to `map-iam-admin-dev` because Casdoor's default for it is the publicly
# documented `123`. They are dev credentials by construction: the IdP port binds
# to loopback (IDP_BIND) for the same reason CONTROLPLANE_BIND does. Replace all
# four before binding either to anything wider. See deploy/compose/README.md.
# SSL_CERT_FILE is the seventh and is not optional either: the JWKS URL above is
# https, and its certificate comes from a CA the proxy generates on first boot,
# which no image trusts by default. It is empty in the default stack on purpose —
# the variable REPLACES Go's default certificate-file list rather than adding to
# it, so setting it when the profile is off would leave outbound TLS depending on
# the image's certificate DIRECTORY alone.
# IDENTITY_MODE=oidc
# IDENTITY_OIDC_ISSUER=http://localhost:8000
# IDENTITY_OIDC_AUDIENCE=map-console-dev
# IDENTITY_OIDC_JWKS_URL=https://idp:8443/.well-known/jwks
# IDENTITY_CLAIM_ROLES=groups
# IDENTITY_ROLE_MAP=map/platform-admins=admin,map/platform-devs=developer,map/platform-read=viewer
# SSL_CERT_FILE=/etc/idp-ca/caddy/pki/authorities/local/root.crt
